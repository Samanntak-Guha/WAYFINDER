# WAYFINDER Global Environment Configuration
# Copy this file to .env and adjust variables as needed

# AI Provider Configuration
# Choose: "freellmapi", "nvidia_nim", or "custom_openai"
LLM_PROVIDER=freellmapi

# Direct NVIDIA NIM Configuration (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Local / Dev Gateway (FreeLLMAPI)
FREE_LLM_API_BASE_URL=http://127.0.0.1:31415/v1
FREE_LLM_API_KEY=freellmapi-cd5d18fe34df4d9ae6e418b82cb188ca6218c7df87b182df
FREE_LLM_API_MODEL=claude-haiku-4-5

# Backend Core Configuration
SECRET_KEY=wayfinder-super-secret-jwt-key-research-grade-2026
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./wayfinder.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/wayfinder

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=127.0.0.1
PORT=8000

# Frontend Next.js Public Variables
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
